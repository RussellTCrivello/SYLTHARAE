# =============================================================================
# SYLTHARAE — Environment Configuration
# =============================================================================
# Copy this file to .env and edit. NEVER commit .env with real credentials.
#
# Precedence (12-factor):
#   1. OS environment variables  (highest — always win)
#   2. .env file                  (loaded at startup, override=False)
#   3. settings.json              (runtime settings store)
#   4. config.example.json        (project defaults)
#   5. Dataclass defaults         (lowest)
#
# After editing .env, restart the server for changes to take effect.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# FLASK / APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for session signing and CSRF protection.
# Auto-generated on first start if empty (saved to .flask_secret_key).
# In production, set a strong random value (>= 64 hex chars).
FLASK_SECRET_KEY=

# Deployment environment: development | staging | production
# Controls debug mode, HSTS headers, cookie security, and error verbosity.
FLASK_ENV=production

# Enable Flask debug mode (auto-reloader, interactive debugger).
# MUST be False in production — the server refuses to start if FLASK_DEBUG=true
# while FLASK_ENV=production.
FLASK_DEBUG=false

# Network binding
FLASK_HOST=0.0.0.0
FLASK_PORT=5000


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=analysis
DB_USER=postgres
DB_PASSWORD=

# Connection pool — tuned by the resource coordinator at runtime.
# These are the *requested* values; the coordinator may lower them.
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=25
DB_POOL_TIMEOUT=30

# Per-query timeout in seconds.
DB_QUERY_TIMEOUT=60


# ─────────────────────────────────────────────────────────────────────────────
# ADMINISTRATOR (first-run bootstrap)
# ─────────────────────────────────────────────────────────────────────────────

# If set, these are used for the initial admin account created on first startup.
# If empty, a random password is generated and saved to the runtime directory.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Minimum password length enforced for all accounts (admin and user).
PASSWORD_MIN_LENGTH=12


# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# Failed-login lockout: number of attempts before the account is locked.
SECURITY_MAX_FAILED_LOGINS=5

# Lockout duration in minutes.
SECURITY_LOCKOUT_MINUTES=15

# Session lifetime in hours (absolute).
SECURITY_SESSION_HOURS=12

# Idle session timeout in hours (sliding window).
SECURITY_SESSION_IDLE_HOURS=6

# Rate limiting: requests per minute / per hour per client.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600


# ─────────────────────────────────────────────────────────────────────────────
# INGESTION (server-path SYLTHARAE)
# ─────────────────────────────────────────────────────────────────────────────

# Semicolon-separated absolute directories the server may read from disk.
# Leave empty to disable server-path ingestion (drag-and-drop uploads still work).
#   Windows:  INGESTION_ROOTS=C:\data\evidence;D:\inbox
#   POSIX:    INGESTION_ROOTS=/data/evidence;/srv/inbox
INGESTION_ROOTS=

# Processing
MAX_WORKERS=8
FILE_CHUNK_SIZE=10485760
FILE_PROCESSING_TIMEOUT=1200


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION DATA DIRECTORY
# ─────────────────────────────────────────────────────────────────────────────

# Root for all runtime data: logs, uploads, cache, checkpoints, settings.
# Default: ~/.local/share/file-analysis (Linux) or ~/AppData/Local/file-analysis (Windows).
# Uncomment and set to override:
# APP_DATA_DIR=/opt/file-analysis/data


# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured action logging to the database (audit trail).
ACTION_LOGGING_ENABLED=true

# Enable performance monitoring (CPU, memory, query timing).
PERFORMANCE_MONITORING=true

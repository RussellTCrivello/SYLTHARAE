msgstr "הוספת הקטגוריה הראשונה"

msgid "Add First Word"
msgstr "הוספת המילה הראשונה"

msgid "Add Keyword"
msgstr "הוספת מילת מפתח"

msgid ""
"Add Keyword: Create keyword phrases by selecting or creating multiple words "
"(minimum 2 words required). Keywords can be associated with categories"
msgstr ""
"הוספת מילת מפתח: צרו צירופי מילות מפתח בבחירה או יצירה של מספר מילים (נדרשות"
" מינימום 2 מילים). מילות מפתח יכולות להיות משויכות לקטגוריות"

msgid "Add New Side"
msgstr "הוספת צד חדש"

msgid "Add New Source"
msgstr "הוספת מקור חדש"

msgid "Add Relationship"
msgstr "הוספת קשר"

msgid "Add Side"
msgstr "הוספת צד"

msgid ""
"Add Side: Create new sides/parties with name and importance level. Sides "
"help organize data by different groups or entities"
msgstr ""
"הוספת צד: צרו צדדים/גורמים חדשים עם שם ורמת חשיבות. צדדים מסייעים לארגן "
"נתונים לפי קבוצות או ישויות שונות"

msgid "Add Source"
msgstr "הוספת מקור"

msgid ""
"Add Source: Create new information sources with details like name, job/type,"
" importance, country, city, description, social media accounts, ownership, "
"and access status"
msgstr ""
"הוספת מקור: צרו מקורות מידע חדשים עם פרטים כגון שם, תפקיד/סוג, חשיבות, "
"מדינה, עיר, תיאור, חשבונות מדיה חברתית, בעלות ומצב גישה"

msgid "Add User"
msgstr "הוספת משתמש"

msgid "Add Word"

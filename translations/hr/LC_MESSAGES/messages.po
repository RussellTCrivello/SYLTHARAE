#: core/reporting/definitions.py
msgid "Distinctive Terms Report"
msgstr "Izvješće o razlikovnim pojmovima"

#: core/reporting/definitions.py
msgid "Which words the selected documents use more (or less) often than the rest of the collection, with how sure that is."
msgstr "Koje riječi odabrani dokumenti koriste češće (ili rjeđe) od ostatka zbirke i koliko je to pouzdano."

#: core/reporting/definitions.py
msgid "Used more often in the selection"
msgstr "Češće korištene u odabiru"

#: core/reporting/definitions.py
msgid "Used less often in the selection"
msgstr "Rjeđe korištene u odabiru"

#: core/reporting/datasets.py
msgid "Term"
msgstr "Pojam"

#: core/reporting/datasets.py
msgid "Occurrences in the selection"
msgstr "Pojavljivanja u odabiru"

#: core/reporting/datasets.py
msgid "Occurrences in the rest of the collection"
msgstr "Pojavljivanja u ostatku zbirke"

#: core/reporting/datasets.py
msgid "Log-likelihood (G2)"
msgstr "Log-vjerodostojnost (G2)"

#: core/reporting/datasets.py
msgid "Log Ratio"
msgstr "Logaritamski omjer (Log Ratio)"

#: core/reporting/datasets.py
msgid "Counted words in the selection"
msgstr "Prebrojene riječi u odabiru"

#: core/reporting/datasets.py
msgid "Counted words in the rest of the collection"
msgstr "Prebrojene riječi u ostatku zbirke"

#: core/reporting/datasets.py
msgid "Contents in the selection"
msgstr "Sadržaji u odabiru"

#: core/reporting/datasets.py
msgid "Contents in the rest of the collection"
msgstr "Sadržaji u ostatku zbirke"

#: core/reporting/datasets.py
msgid "Word records without a count"
msgstr "Zapisi riječi bez broja"

#: core/reporting/datasets.py
msgid "Significant terms"
msgstr "Značajni pojmovi"

#: core/reporting/definitions.py
msgid "About the Distinctive Terms Report"
msgstr "O izvješću o razlikovnim pojmovima"

#: core/reporting/definitions.py
msgid "Compares how often each word occurs in the documents you selected with the rest of the collection you may see, and lists the words whose difference is statistically reliable."
msgstr "Uspoređuje koliko se često svaka riječ pojavljuje u dokumentima koje ste odabrali s ostatkom zbirke koji smijete vidjeti i navodi riječi čija je razlika statistički pouzdana."

#: core/reporting/definitions.py
msgid "Distinctive terms"
msgstr "Razlikovni pojmovi"

#: core/analytics/kinds.py
msgid "Keyness compares stored word forms. It does not merge inflections, synonyms or languages, so a selection in another language than the collection shows its function words. Next step: open the documents that contain the top terms."
msgstr "Ključnost uspoređuje pohranjene oblike riječi. Ne spaja fleksije, sinonime ni jezike, pa odabir na drugom jeziku od zbirke pokazuje svoje funkcionalne riječi. Sljedeći korak: otvorite dokumente koji sadrže najistaknutije pojmove."

#: core/analytics/kinds.py
msgid "Next step: widen the criteria, or check that the matching documents were processed."
msgstr "Sljedeći korak: proširite kriterije ili provjerite jesu li odgovarajući dokumenti obrađeni."

#: core/analytics/kinds.py
msgid "Keyness compares stored word forms. It does not merge inflections, synonyms or languages. %(unknown_rows)s word records without a count were left out of every total. Next step: open the documents that contain the top terms."
msgstr "Ključnost uspoređuje pohranjene oblike riječi. Ne spaja fleksije, sinonime ni jezike. %(unknown_rows)s zapisa riječi bez broja izostavljeno je iz svih zbrojeva. Sljedeći korak: otvorite dokumente koji sadrže najistaknutije pojmove."

#: core/analytics/kinds.py
msgid "No statistical test was performed."
msgstr "Nije proveden nijedan statistički test."

#: core/analytics/kinds.py
msgid "Only terms with G2 of at least %(critical)s count as findings (p < 0.0001; %(source)s). Every term in the vocabulary is tested, so the weaker significance levels are not treated as findings."
msgstr "Samo pojmovi s G2 od najmanje %(critical)s smatraju se nalazima (p < 0.0001; %(source)s). Testira se svaki pojam u rječniku, pa se slabije razine značajnosti ne smatraju nalazima."

#: core/analytics/kinds.py
msgid "Any difference between the selection and the collection is not in word frequency at this level; categories, sources or dates may show one."
msgstr "Eventualna razlika između odabira i zbirke nije u učestalosti riječi na ovoj razini; mogu je pokazati kategorije, izvori ili datumi."

#: core/analytics/kinds.py
msgid "No conclusion can be drawn from this section."
msgstr "Iz ovog odjeljka ne može se izvesti nikakav zaključak."

#: core/analytics/kinds.py
msgid "These terms characterise the selection against the rest of the collection. They show where it differs, not why: read the documents that contain them before drawing conclusions."
msgstr "Ovi pojmovi obilježavaju odabir u odnosu na ostatak zbirke. Pokazuju gdje se razlikuje, a ne zašto: pročitajte dokumente koji ih sadrže prije donošenja zaključaka."

#: core/analytics/kinds.py
msgid "The matching contents are the whole visible collection, so there is no reference to compare them with."
msgstr "Odgovarajući sadržaji čine cijelu vidljivu zbirku, pa nema referentnog skupa za usporedbu."

#: core/analytics/kinds.py
msgid "No visible content matches the criteria, so there is nothing to compare."
msgstr "Nijedan vidljivi sadržaj ne odgovara kriterijima, pa nema što usporediti."

#: core/analytics/kinds.py
msgid "The matching contents have no counted words, so keyness cannot be measured."
msgstr "Odgovarajući sadržaji nemaju prebrojenih riječi, pa se ključnost ne može izmjeriti."

#: core/analytics/kinds.py
msgid "No term reaches G2 %(critical)s: at this level the selection's word frequencies do not differ from the rest of the collection."
msgstr "Nijedan pojam ne doseže G2 od %(critical)s: na ovoj se razini učestalosti riječi u odabiru ne razlikuju od ostatka zbirke."

#: core/analytics/kinds.py
msgid "%(significant)s terms are used significantly more often in the selection than in the rest of the collection (G2 of at least %(critical)s). The strongest is \"%(top_term)s\": G2 %(top_g2)s, Log Ratio %(top_log_ratio)s."
msgstr "Pojmova koji se u odabiru koriste značajno češće nego u ostatku zbirke: %(significant)s (G2 najmanje %(critical)s). Najjači je „%(top_term)s”: G2 %(top_g2)s, logaritamski omjer %(top_log_ratio)s."

#: core/analytics/kinds.py
msgid "%(significant)s terms are used significantly less often in the selection than in the rest of the collection (G2 of at least %(critical)s). The strongest is \"%(top_term)s\": G2 %(top_g2)s, Log Ratio %(top_log_ratio)s."
msgstr "Pojmova koji se u odabiru koriste značajno rjeđe nego u ostatku zbirke: %(significant)s (G2 najmanje %(critical)s). Najjači je „%(top_term)s”: G2 %(top_g2)s, logaritamski omjer %(top_log_ratio)s."

#: core/analytics/kinds.py
msgid "Log-likelihood keyness (G2) compares word frequencies in the selected contents with the other visible contents."
msgstr "Ključnost po log-vjerodostojnosti (G2) uspoređuje učestalosti riječi u odabranim sadržajima s ostalim vidljivim sadržajima."

#: core/analytics/kinds.py
msgid "Log-likelihood keyness (G2) and Log Ratio compare %(target_tokens)s counted words in %(target_contents)s selected contents with %(reference_tokens)s words in the other %(reference_contents)s visible contents. Listed: the %(shown)s terms used more often in the selection, highest G2 first."
msgstr "Ključnost (G2) i logaritamski omjer uspoređuju %(target_tokens)s prebrojenih riječi u %(target_contents)s odabranih sadržaja s %(reference_tokens)s riječi u ostalih %(reference_contents)s vidljivih sadržaja. Navedeno: %(shown)s pojmova češće korištenih u odabiru, od najvećeg G2."

#: core/analytics/kinds.py
msgid "Log-likelihood keyness (G2) and Log Ratio compare %(target_tokens)s counted words in %(target_contents)s selected contents with %(reference_tokens)s words in the other %(reference_contents)s visible contents. Listed: the %(shown)s terms used less often in the selection, highest G2 first."
msgstr "Ključnost (G2) i logaritamski omjer uspoređuju %(target_tokens)s prebrojenih riječi u %(target_contents)s odabranih sadržaja s %(reference_tokens)s riječi u ostalih %(reference_contents)s vidljivih sadržaja. Navedeno: %(shown)s pojmova rjeđe korištenih u odabiru, od najvećeg G2."


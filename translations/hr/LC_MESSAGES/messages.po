msgstr "E-adrese"

msgid "Total matches"
msgstr "Ukupno pogodaka"

msgid "Email Addresses Overview"
msgstr "Pregled e-adresa"

msgid ""
"This page displays all email addresses found in your files during analysis"
msgstr ""
"Ova stranica prikazuje sve e-adrese pronađene u vašim datotekama tijekom "
"analize"

msgid ""
"Email addresses are automatically extracted from file content and metadata"
msgstr "E-adrese automatski se izvlače iz sadržaja datoteka i metapodataka"

msgid "View email addresses with their associated files and usage statistics"
msgstr "Pregledajte e-adrese s pridruženim datotekama i statistikama upotrebe"

msgid ""
"Use email addresses to identify contacts, senders, and recipients in your "
"documents"
msgstr ""
"Koristite e-adrese za prepoznavanje kontakata, pošiljatelja i primatelja u "
"dokumentima"

msgid "Searching Email Addresses"
msgstr "Pretraživanje e-adresa"

msgid "Use the search box to find specific email addresses quickly"
msgstr "Koristite okvir za pretragu za brzo pronalaženje određenih e-adresa"

msgid "Search is case-insensitive and matches partial email addresses"
msgstr ""
"Pretraga ne razlikuje velika i mala slova i podudara djelomične e-adrese"

msgid "Filter email addresses by domain, file association, or usage frequency"
msgstr ""
"Filtrirajte e-adrese po domeni, povezanosti s datotekom ili učestalosti "
"upotrebe"

msgid "Sort email addresses alphabetically or by usage count"
msgstr "Sortirajte e-adrese abecedno ili po broju upotreba"

msgid "Email Address Details"
msgstr "Pojedinosti e-adrese"

msgid "Click on any email address to view details and associated files"
msgstr ""
"Kliknite bilo koju e-adresu za prikaz pojedinosti i pridruženih datoteka"

msgid "See which files contain each email address"
msgstr "Pogledajte koje datoteke sadrže svaku e-adresu"

msgid "View usage statistics showing how often each email appears"
msgstr ""
"Pregledajte statistike upotrebe koje pokazuju koliko se često svaka e-adresa"
" pojavljuje"

msgid "Export email addresses for use in other applications or reports"
msgstr "Izvezite e-adrese za upotrebu u drugim aplikacijama ili izvješćima"

msgid "Search email-like words..."
msgstr "Pretraži riječi slične e-pošti..."

msgid "Server-side filter (affects pagination/export/copy)."
msgstr "Filtriranje na poslužitelju (utječe na paginaciju/izvoz/kopiranje)."


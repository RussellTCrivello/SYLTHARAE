msgstr "الكلمات في الفئة"

#: core/reporting/datasets.py
msgid "Keywords in category"
msgstr "الكلمات المفتاحية في الفئة"

#: core/reporting/datasets.py
msgid "Matching contents"
msgstr "المحتويات المطابقة"

#: core/reporting/datasets.py
msgid "Occurrences in matched contents"
msgstr "مرات الورود في المحتويات المطابقة"

#: core/reporting/datasets.py

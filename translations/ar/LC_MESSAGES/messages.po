msgid_plural "%(significant)s terms are used significantly less often in the selection than in the rest of the collection (G2 of at least %(critical)s)."
msgstr[0] "لا يُستخدم أي مصطلح (%(significant)s) في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."
msgstr[1] "مصطلح واحد يُستخدم في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."
msgstr[2] "مصطلحان يُستخدمان في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."
msgstr[3] "%(significant)s مصطلحات تُستخدم في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."
msgstr[4] "%(significant)s مصطلح يُستخدم في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."
msgstr[5] "%(significant)s مصطلحًا تُستخدم في التحديد أقل بدلالة إحصائية من بقية المجموعة (G2 لا يقل عن %(critical)s)."

#: core/analytics/kinds.py

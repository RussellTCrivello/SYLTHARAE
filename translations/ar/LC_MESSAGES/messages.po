msgid_plural "%(unknown_rows)s word records without a count were left out of every total."
msgstr[0] "استُبعد %(unknown_rows)s سجل كلمات بلا عدد من كل المجاميع."
msgstr[1] "استُبعد سجل كلمات واحد بلا عدد من كل المجاميع."
msgstr[2] "استُبعد سجلا كلمات بلا عدد من كل المجاميع."
